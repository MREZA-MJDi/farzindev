APP_NAME=Farzin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production admin seed credentials (set before running db:seed)
ADMIN_NAME="Farzin Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=farzin
DB_USERNAME=farzin_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# External payment adapters remain disabled until tested against the real merchant API.
# Do not enable a provider with placeholder credentials or unverified endpoint/amount rules.
PAYMENT_DEFAULT_GATEWAY=digipay

DIGIPAY_ENABLED=false
DIGIPAY_API_CONTRACT_CONFIRMED=false
DIGIPAY_MERCHANT_ID=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_API_KEY=
DIGIPAY_ACCESS_TOKEN=
DIGIPAY_BASE_URL=
DIGIPAY_CALLBACK_URL=
DIGIPAY_TIMEOUT=30
DIGIPAY_CREATE_ENDPOINT=
DIGIPAY_VERIFY_ENDPOINT=
DIGIPAY_STATUS_ENDPOINT=
DIGIPAY_CANCEL_ENDPOINT=
DIGIPAY_REFUND_ENDPOINT=

SNAPPAY_ENABLED=false
SNAPPAY_API_CONTRACT_CONFIRMED=false
SNAPPAY_MERCHANT_ID=
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_API_KEY=
SNAPPAY_ACCESS_TOKEN=
SNAPPAY_BASE_URL=
SNAPPAY_CALLBACK_URL=
SNAPPAY_TIMEOUT=30
SNAPPAY_CREATE_ENDPOINT=
SNAPPAY_VERIFY_ENDPOINT=
SNAPPAY_STATUS_ENDPOINT=
SNAPPAY_CANCEL_ENDPOINT=
SNAPPAY_REFUND_ENDPOINT=

TOROBPAY_ENABLED=false
TOROBPAY_API_CONTRACT_CONFIRMED=false
TOROBPAY_MERCHANT_ID=
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_API_KEY=
TOROBPAY_ACCESS_TOKEN=
TOROBPAY_BASE_URL=
TOROBPAY_CALLBACK_URL=
TOROBPAY_TIMEOUT=30
TOROBPAY_CREATE_ENDPOINT=
TOROBPAY_VERIFY_ENDPOINT=
TOROBPAY_STATUS_ENDPOINT=
TOROBPAY_CANCEL_ENDPOINT=
TOROBPAY_REFUND_ENDPOINT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
